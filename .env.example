# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Public HTTPS URL Telegram will POST updates to. Must be reachable over HTTPS.
# The app appends /telegram/webhook itself if you omit it.
TELEGRAM_WEBHOOK_URL=https://your-domain.example.com/telegram/webhook
# Optional secret token Telegram will echo back in a header; leave blank to skip verification.
TELEGRAM_WEBHOOK_SECRET=

# --- Server ---
PORT=8787
LOG_LEVEL=info

# --- PostgreSQL (SiteGround-hosted) ---
# Standard libpq/pg connection string, e.g.:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Only set to "false" if your Postgres requires SSL with an unverifiable certificate.
# Leave as "true" (or remove) to disable SSL — required for hosts without TLS.
PG_SSL_REJECT_UNAUTHORIZED=true

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
