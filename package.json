{
  "name": "expense-tracker-bot",
  "version": "2.0.0",
  "description": "AI expense tracker bot for Telegram with DeepSeek integration. Used for tracking expenses and analyzing spending patterns.",
  "type": "module",
  "author": "Sayan Dey",
  "homepage": "https://github.com/sayandey18/expense-tracker-bot",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
